// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  ADMIN_ASSISTANT
  VENDOR
  DELIVERY
}

enum NotificationTopic {
  CUSTOMER
  VENDOR
  DELIVERY
  ALL
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
}

enum VendorStatus {
  OPEN
  CLOSED
  SOON
}

model User {
  id             Int             @id @default(autoincrement())
  phone          String          @unique
  name           String?
  avatar         String?
  fcm            String?
  password       String
  token          String
  refresh_token  String?
  wallet         Decimal         @default(0)
  role           UserRole
  addresses      UserAddresses[]
  transaction    Transaction[]
  notifications  Notification[]
  deleted        Boolean         @default(false)
  deletedAt      DateTime?
  // relations---------------------------------------------------------------------//
  vendor         Vendor?
  // --- OTHER --------------------------------------------------------------------- //
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  vendorId       Int?
  MainCategory   MainCategory?   @relation(fields: [mainCategoryId], references: [id])
  mainCategoryId Int?
  homeCategory   HomeCategory?   @relation(fields: [homeCategoryId], references: [id])
  homeCategoryId Int?
  SubCategory    SubCategory?    @relation(fields: [subCategoryId], references: [id])
  subCategoryId  Int?
  complain       Complain[]
}

model Vendor {
  id                Int          @id
  name              Json
  weekTimes         Json?
  status            VendorStatus @default(OPEN)
  location          String?
  longitudes        String?
  latitude          String?
  cover             String?
  feature           Boolean      @default(false)
  active            Boolean      @default(true)
  deliveryCost      Decimal      @default(0)
  deliveryCostOffer Decimal      @default(0)
  hasOffer          Boolean      @default(false)
  pickUp            Boolean      @default(false)
  orderTime         Int          @default(0)
  offerName         String?
  rate              Decimal      @default(0)
  reviewsCount      Int          @default(0)
  user              User         @relation(fields: [id], references: [id])
}

model UserAddresses {
  id         Int     @id @default(autoincrement())
  name       String?
  longitudes String?
  latitude   String?
  User       User?   @relation(fields: [userId], references: [id])
  userId     Int?
}

model Transaction {
  id           Int             @id @default(autoincrement())
  walletBefore Decimal
  amount       Decimal
  walletAfter  Decimal
  type         TransactionType
  createdBy    String
  User         User?           @relation(fields: [userId], references: [id])
  userId       Int?
  // --- OTHER --------------------------------------------------------------------- //
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Notification {
  // --- IDENTIFICATION --------------------------------------------------------------------- //
  id        Int                @id @default(autoincrement())
  // --- DETAILS --------------------------------------------------------------------------- //
  title     String
  content   String             @default("")
  topic     NotificationTopic?
  // --- FOREIGN KEYS --------------------------------------------------------------------------- //
  userId    Int?
  // --- RELATIONS --------------------------------------------------------------------------- //
  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // --- STATUS --------------------------------------------------------------------------- //
  seen      Boolean            @default(false)
  // --- OTHER --------------------------------------------------------------------- //
  createdAt DateTime           @default(now())

  @@index([userId])
}

model Banner {
  id        Int      @id @default(autoincrement())
  order     Int
  image     String
  createdBy String
  active    Boolean  @default(true)
  // --- OTHER --------------------------------------------------------------------- //
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MainCategory {
  id          Int           @id @default(autoincrement())
  name        Json
  description Json
  image       String
  active      Boolean       @default(true)
  deleted     Boolean       @default(false)
  deletedBy   String?
  createdBy   String
  vendors     User[]
  categories  SubCategory[]
  // --- OTHER --------------------------------------------------------------------- //
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model SubCategory {
  id             Int           @id @default(autoincrement())
  name           Json
  image          String
  vendors        User[]
  // --- OTHER --------------------------------------------------------------------- //
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  mainCategory   MainCategory? @relation(fields: [mainCategoryId], references: [id])
  mainCategoryId Int?
}

model HomeCategory {
  id        Int      @id @default(autoincrement())
  name      Json
  image     String?
  order     Int
  active    Boolean  @default(true)
  vendors   User[]
  // --- OTHER ---------------------------------------------------------------------//
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Complain {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  // --- OTHER ---------------------------------------------------------------------//
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
