// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  ADMIN_ASSISTANT
  VENDOR
  DELIVERY
}

enum NotificationTopic {
  CUSTOMER
  VENDOR
  DELIVERY
  ALL
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
}

enum VendorStatus {
  OPEN
  CLOSED
  SOON
}

enum OrderStatus {
  REGISTERED
  RECEIVED
  PREPARING
  FINISHED
  TACKED
  WITH_DELIVERY
  COMPLETE
  CANCELED
  DELETED
}

model User {
  id                Int             @id @default(autoincrement())
  phone             String          @unique
  name              String?
  avatar            String?
  fcm               String?
  password          String
  token             String
  refresh_token     String[]
  wallet            Decimal         @default(0)
  role              UserRole
  addresses         UserAddresses[]
  transaction       Transaction[]
  notifications     Notification[]
  deleted           Boolean         @default(false)
  deletedAt         DateTime?
  // relations---------------------------------------------------------------------//
  favoritesProducts Product[]       @relation("UserFavoritesProducts")
  favoritesVendors  Vendor[]        @relation("UserFavoritesVendors")
  vendor            Vendor?
  delivery          Delivery?
  // --- OTHER --------------------------------------------------------------------- //
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  vendorId          Int?
  MainCategory      MainCategory?   @relation(fields: [mainCategoryId], references: [id])
  mainCategoryId    Int?
  homeCategory      HomeCategory?   @relation(fields: [homeCategoryId], references: [id])
  homeCategoryId    Int?
  SubCategory       SubCategory?    @relation(fields: [subCategoryId], references: [id])
  subCategoryId     Int?
  complain          Complain[]
  cart              Cart?
  orders            Order[]
}

model Delivery {
  id     Int     @id @default(autoincrement())
  online Boolean @default(false)
  orders Order[]

  user User @relation(fields: [id], references: [id])
}

model Vendor {
  id                Int          @id
  name              Json
  weekTimes         Json?
  status            VendorStatus @default(OPEN)
  location          String?
  longitudes        String?
  latitude          String?
  cover             String?
  feature           Boolean      @default(false)
  active            Boolean      @default(true)
  deliveryCost      Decimal      @default(0)
  deliveryCostOffer Decimal      @default(0)
  hasOffer          Boolean      @default(false)
  pickUp            Boolean      @default(false)
  orderTime         Int          @default(0)
  offerName         Json?
  rate              Decimal      @default(0)
  reviewsCount      Int          @default(0)
  user              User         @relation(fields: [id], references: [id])
  //-------------------------------------------------------------------------------
  Product           Product[]
  carts             Cart[]
  favoritedByUsers  User[]       @relation("UserFavoritesVendors")
  orders            Order[]
}

model UserAddresses {
  id         Int     @id @default(autoincrement())
  name       String?
  longitudes String?
  latitude   String?
  User       User?   @relation(fields: [userId], references: [id])
  userId     Int?
  orders     Order[]
}

model Transaction {
  id           Int             @id @default(autoincrement())
  walletBefore Decimal
  amount       Decimal
  walletAfter  Decimal
  type         TransactionType
  createdBy    String
  User         User?           @relation(fields: [userId], references: [id])
  userId       Int?
  // --- OTHER --------------------------------------------------------------------- //
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Notification {
  // --- IDENTIFICATION --------------------------------------------------------------------- //
  id        Int                @id @default(autoincrement())
  // --- DETAILS --------------------------------------------------------------------------- //
  title     String
  content   String             @default("")
  topic     NotificationTopic?
  // --- FOREIGN KEYS --------------------------------------------------------------------------- //
  userId    Int?
  // --- RELATIONS --------------------------------------------------------------------------- //
  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // --- STATUS --------------------------------------------------------------------------- //
  seen      Boolean            @default(false)
  // --- OTHER --------------------------------------------------------------------- //
  createdAt DateTime           @default(now())

  @@index([userId])
}

model Banner {
  id        Int      @id @default(autoincrement())
  order     Int
  image     String
  createdBy String
  active    Boolean  @default(true)
  // --- OTHER --------------------------------------------------------------------- //
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MainCategory {
  id                Int               @id @default(autoincrement())
  name              Json
  description       Json
  image             String
  active            Boolean           @default(true)
  deleted           Boolean           @default(false)
  deletedBy         String?
  createdBy         String
  vendors           User[]
  categories        SubCategory[]
  productCategories ProductCategory[]
  // --- OTHER --------------------------------------------------------------------- //
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model SubCategory {
  id             Int           @id @default(autoincrement())
  name           Json
  image          String
  vendors        User[]
  // --- OTHER --------------------------------------------------------------------- //
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  mainCategory   MainCategory? @relation(fields: [mainCategoryId], references: [id])
  mainCategoryId Int?
}

model HomeCategory {
  id        Int      @id @default(autoincrement())
  name      Json
  image     String?
  order     Int
  active    Boolean  @default(true)
  vendors   User[]
  // --- OTHER ---------------------------------------------------------------------//
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Complain {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  // --- OTHER ---------------------------------------------------------------------//
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductCategory {
  id             Int           @id @default(autoincrement())
  name           Json
  products       Product[]
  // --- OTHER --------------------------------------------------------------------- //
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  MainCategory   MainCategory? @relation(fields: [mainCategoryId], references: [id])
  mainCategoryId Int?
}

model Product {
  id               Int     @id @default(autoincrement())
  name             Json
  description      Json
  image            String
  price            Decimal
  available        Boolean @default(true)
  orders           Int     @default(0)
  //---relations------------------------------------------------------------------//
  favoritedByUsers User[]  @relation("UserFavoritesProducts")

  Vendor            Vendor?          @relation(fields: [vendorId], references: [id])
  vendorId          Int?
  // --- OTHER ---------------------------------------------------------------------//
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ProductCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id])
  productCategoryId Int?
  groups            Group[]
  cartProducts      CartProduct[]
}

model Group {
  id        Int      @id @default(autoincrement())
  name      Json
  multi     Boolean
  Product   Product? @relation(fields: [productId], references: [id])
  productId Int?
  options   Option[]
}

model Option {
  id      Int     @id @default(autoincrement())
  name    Json
  price   Decimal
  Group   Group?  @relation(fields: [groupId], references: [id])
  groupId Int?
}

model Cart {
  id        Int           @id @default(autoincrement())
  subtotal  Float         @default(0)
  shipping  Float         @default(0)
  total     Float         @default(0)
  quantity  Int           @default(0)
  vendor    Vendor?       @relation(fields: [vendorId], references: [id])
  vendorId  Int?
  user      User          @relation(fields: [userId], references: [id])
  userId    Int           @unique
  products  CartProduct[]
  // --- OTHER ---------------------------------------------------------------------//
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model CartProduct {
  id        Int      @id @default(autoincrement())
  subtotal  Float    @default(0)
  total     Float    @default(0)
  quantity  Int      @default(0)
  groups    Json?
  ordered   Boolean  @default(false)
  Cart      Cart?    @relation(fields: [cartId], references: [id])
  cartId    Int?
  product   Product? @relation(fields: [productId], references: [id])
  productId Int?

  Order   Order? @relation(fields: [orderId], references: [id])
  orderId Int?
}

model Order {
  id              Int             @id @default(autoincrement())
  subtotal        Float           @default(0)
  shipping        Float           @default(0)
  total           Float           @default(0)
  quantity        Int             @default(0)
  paymentMethod   String
  time            Int             @default(0)
  status          OrderStatus
  deleted         Boolean         @default(false)
  // --- OTHER ---------------------------------------------------------------------//
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  //---relations--------------------------------------------------------------------//
  User            User?           @relation(fields: [userId], references: [id])
  userId          Int?
  Vendor          Vendor?         @relation(fields: [vendorId], references: [id])
  vendorId        Int?
  UserAddresses   UserAddresses?  @relation(fields: [userAddressesId], references: [id])
  userAddressesId Int?
  Delivery        Delivery?       @relation(fields: [deliveryId], references: [id])
  deliveryId      Int?
  products        CartProduct[]
  orderTimeLines  OrderTimeLine[]
}

model OrderTimeLine {
  id        Int      @id @default(autoincrement())
  content   String
  // --- OTHER ---------------------------------------------------------------------//
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Order     Order?   @relation(fields: [orderId], references: [id])
  orderId   Int?
}

model General {
  id      Int     @id @default(autoincrement())
  name    String
  content String
  active  Boolean @default(false)
}
